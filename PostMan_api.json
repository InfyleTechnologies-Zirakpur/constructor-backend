{
  "info": {
    "name": "Construction Project",
    "description": "Every API built today — Auth (global + Firebase OTP, single-session) + Media (Bunny) + Contractors/Companies/Projects/Sites/Site Engineers + Jobs/Applications + Daily Ops (labour/material/expenses/reports) + Calculators + Chat. Import: Postman → Import → File. Set {{baseUrl}}, {{TOKEN}} (from login), {{companyId}}, {{projectId}}, {{siteId}}, {{jobId}}, {{applicationId}}. All guarded AuthGuard + RolesGuard + permission-matrix + verifySiteAccess.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "TOKEN",
      "value": "eyJ...paste accessToken"
    },
    {
      "key": "companyId",
      "value": "<companyId>"
    },
    {
      "key": "contractorId",
      "value": "<contractorId>"
    },
    {
      "key": "projectId",
      "value": "<projectId>"
    },
    {
      "key": "siteId",
      "value": "<siteId>"
    },
    {
      "key": "jobId",
      "value": "<jobId>"
    },
    {
      "key": "applicationId",
      "value": "<applicationId>"
    },
    {
      "key": "documentId",
      "value": "<documentId>"
    },
    {
      "key": "userId",
      "value": "<userId>"
    }
  ],
  "item": [
    {
      "name": "01 Auth — Global",
      "item": [
        {
          "name": "Register — Company",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Bharat Constructions\",\n  \"email\": \"hr@bharat.com\",\n  \"password\": \"Bharat@123\",\n  \"role\": \"company\"\n}"
            },
            "description": "Company/Contractor/Site Engineer/Admin — same endpoint, role gates. Seeker can also use email. → {user, accessToken, refreshToken}"
          }
        },
        {
          "name": "Login — Email+Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"hr@bharat.com\",\n  \"password\": \"Bharat@123\"\n}"
            },
            "description": "Checks isBlocked/isActive/lockout (5 fails→15m), bumps tokenVersion → other device kicked. Copy accessToken to {{TOKEN}}."
          }
        },
        {
          "name": "Request OTP — Seeker phone (dev log)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/request-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "request-otp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9876543210\"\n}"
            },
            "description": "Dev: logs [DEV MODE] OTP for 9876543210: 482917. Prod Firebase: client verifyPhoneNumber() sends real SMS, this not used."
          }
        },
        {
          "name": "Verify OTP — 6-digit dev",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/verify-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth", 
                "verify-otp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9876543210\",\n  \"otp\": \"482917\"\n}"
            },
            "description": "Paste OTP from terminal. → {accessToken, worker} + phoneVerified + tokenVersion bump."
          }
        },
        {
          "name": "Verify OTP — Firebase idToken (real SMS)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/verify-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "verify-otp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9876543210\",\n  \"otp\": \"eyJhbGciOi...firebaseIdToken\"\n}"
            },
            "description": "App getIdToken() after verifyPhoneNumber SMS. Backend verifyIdToken() → same JWT. Keep endpoint, put idToken in otp."
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{TOKEN}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          }
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/users/{{userId}}/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "users",
                "{{userId}}",
                "refresh"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"hex40\"\n}"
            }
          }
        },
        {
          "name": "Logout — kicks all",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{TOKEN}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Bumps tokenVersion + clears refreshToken → old JWTs 401."
          }
        }
      ]
    },
