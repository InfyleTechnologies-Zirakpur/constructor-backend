meta {
  name: Create Payment
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/payments
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "amount": 2500,
    "currency": "INR",
    "workerId": "{{workerId}}",
    "jobId": "{{jobId}}",
    "paymentMethod": "upi",
    "description": "Daily wage disbursement"
  }
}
