meta {
  name: Apply to Job
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/applications/jobs/:jobId/apply
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

params:path {
  jobId: {{jobId}}
}

body:json {
  {
    "coverNote": "I am interested in this job.",
    "experience": "3 years of electrical work",
    "availability": "Immediately"
  }
}
